# Not built or referenced by anything yet -- there are no credentials for
# registry.ugard.win in this environment. It exists so that replacing the
# runtime "apk add" in mbsync-cronjob.yaml with a pinned image is one command
# plus a one-line edit, rather than a design decision to make under pressure.
#
#   podman build -t registry.ugard.win/mailarchive/mbsync:1.5.1 -f Dockerfile.mbsync .
#   podman push registry.ugard.win/mailarchive/mbsync:1.5.1
#
# Then in mbsync-cronjob.yaml: set the image to the tag above, delete the
# "apk add" line from args, and drop the container-level securityContext that
# raises the container to root (it only exists so apk can write to /usr).
FROM alpine:3.23
RUN apk add --no-cache isync ca-certificates
USER 1000:1000
ENTRYPOINT ["mbsync"]
